    "start": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_NO_DOCTOR=1 EXPO_NO_DEPENDENCY_VALIDATION=1 npx expo start --clear",
    "start:local": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_NO_DOCTOR=1 EXPO_NO_DEPENDENCY_VALIDATION=1 npx expo start --clear",
    "start:rork": "npx rork start -p g1kkyf4cspsxgxexk5y8t --tunnel",
    "start:rork:local": "npx rork start -p g1kkyf4cspsxgxexk5y8t",
    "start-web": "npm run start-web:force",
    "start-web:local": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_NO_DOCTOR=1 EXPO_NO_DEPENDENCY_VALIDATION=1 EXPO_WEB_PORT=19007 npx expo start --web --clear",
    "start-web-dev": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_NO_DOCTOR=1 EXPO_NO_DEPENDENCY_VALIDATION=1 EXPO_WEB_PORT=19007 npx expo start --web",
    "start-web:force": "cross-env CI=1 EXPO_ROUTER_APP_ROOT=app EXPO_NO_TUNNEL=1 EXPO_NO_DOCTOR=1 EXPO_NO_DEPENDENCY_VALIDATION=1 EXPO_WEB_PORT=0 EXPO_METRO_PORT=0 npx expo start --web --clear",
    "backend": "node ./node_modules/tsx/dist/cli.mjs backend/server-mock.ts",
    "backend:prod": "node ./node_modules/tsx/dist/cli.mjs backend/server.ts",
    "backend:dev": "node ./node_modules/tsx/dist/cli.mjs backend/server.ts",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/lib/tsc.js -p tsconfig.server.json --noEmit",
    "openapi:lint": "npx --yes @redocly/cli@latest lint openapi.yaml",
    "cleanup:week1": "node ./node_modules/tsx/dist/cli.mjs scripts/week1-cleanup.ts",
    "cleanup:week1:apply": "node ./node_modules/tsx/dist/cli.mjs scripts/week1-cleanup.ts --apply",
    "test": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js",
    "test:all": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js",
    "test:coverage": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --coverage",
    "lint": "expo lint",
    "db:migrate": "node ./node_modules/tsx/dist/cli.mjs backend/db/migrate.ts",
    "seed:agents": "node ./node_modules/tsx/dist/cli.mjs scripts/seed-agents.ts",
    "seed:agents:org": "node ./node_modules/tsx/dist/cli.mjs scripts/seed-agents.ts",
    "test:unit": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --selectProjects integration",
    "test:security": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --selectProjects security",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
