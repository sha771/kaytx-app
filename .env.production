# WhatsApp Business API Configuration
WHATSAPP_API_URL=https://graph.instagram.com/v18.0
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_URL=https://api.rork.app/webhooks/whatsapp
WHATSAPP_CLIENT_ID=your_client_id
WHATSAPP_CLIENT_SECRET=your_client_secret
WHATSAPP_REDIRECT_URI=https://api.rork.app/oauth/whatsapp/callback

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VOICE_WEBHOOK_URL=https://api.rork.app/webhooks/twilio/voice
TWILIO_STATUS_CALLBACK_URL=https://api.rork.app/webhooks/twilio/status

# Platform OAuth Configurations
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=https://api.rork.app/oauth/instagram/callback

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URI=https://api.rork.app/oauth/facebook/callback

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://api.rork.app/oauth/linkedin/callback

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=https://api.rork.app/oauth/twitter/callback

TELEGRAM_CLIENT_ID=your_telegram_client_id
TELEGRAM_CLIENT_SECRET=your_telegram_client_secret
TELEGRAM_REDIRECT_URI=https://api.rork.app/oauth/telegram/callback

SIGNAL_CLIENT_ID=your_signal_client_id
SIGNAL_CLIENT_SECRET=your_signal_client_secret
SIGNAL_REDIRECT_URI=https://api.rork.app/oauth/signal/callback

SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=https://api.rork.app/oauth/slack/callback

# AI API Configuration
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key
AI_API_BASE_URL=https://api.openai.com/v1

# Encryption Configuration
ENCRYPTION_KEY=your_strong_encryption_key_at_least_32_chars

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://rork.app

# Security Configuration (REQUIRED)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long
INTERNAL_API_SECRET=your_internal_api_secret_for_internal_endpoints
PLATFORM_WEBHOOK_SECRET=your_platform_webhook_secret_for_signature_validation

# Optional Services
RABBITMQ_URL=amqp://localhost:5672
REDIS_URL=redis://localhost:6379

# Application Configuration
APP_NAME=Enterprise AI Platform

# Twilio Additional Configuration
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_IVR_ENABLED=false
TWILIO_FORWARD_TO_NUMBER=+1234567890
TWILIO_IVR_SALES_NUMBER=+1234567890
TWILIO_IVR_SUPPORT_NUMBER=+1234567890
TWILIO_IVR_OPERATOR_NUMBER=+1234567890
TWILIO_TRANSCRIPTION_WEBHOOK_URL=https://api.rork.app/webhooks/twilio/transcription
TWILIO_VOICE_MENU_WEBHOOK_URL=https://api.rork.app/webhooks/twilio/voice/menu

# SSO Configuration
SSO_OIDC_CLIENT_ID=your_oidc_client_id
SSO_OIDC_CLIENT_SECRET=your_oidc_client_secret
SSO_OIDC_ISSUER=https://your-idp.com
SSO_OIDC_CALLBACK_URL=https://api.rork.app/auth/sso/oidc/callback
