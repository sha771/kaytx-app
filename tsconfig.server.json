{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@backend/*": ["backend/*"],
      "@core/*": ["core/*"],
      "@lib/*": ["backend/lib/*"],
      "@services/*": ["backend/services/*"],
      "@routes/*": ["backend/routes/*"],
      "@trpc/*": ["backend/trpc/*"],
      "@utils/*": ["backend/utils/*"],
      "@middleware/*": ["backend/middleware/*"],
      "@repositories/*": ["backend/repositories/*"],
      "@config/*": ["backend/config/*"]
    },

    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./backend/types"]
  },
  "include": [
    "backend/**/*.ts",
    "backend/**/*.tsx",
    "core/**/*.ts",
    "core/**/*.tsx",
    "types/**/*.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "app",
    "app/**",
    "scripts",
    "dist",
    "build",
    "coverage",
    ".expo",
    "backend/__tests__",
    "backend/__tests__/**/*",
    "backend/__tests__unit",
    "backend/__tests__unit/**/*",
    "backend/lib/__tests__",
    "backend/lib/__tests__/**/*",
    "backend/audit-system/__tests__",
    "backend/audit-system/__tests__/**/*",
    "backend/integrations",
    "backend/integrations/**/*",
    "backend/bridges",
    "backend/bridges/**/*",
    "backend/controllers",
    "backend/controllers/**/*",
    "backend/mcp",
    "backend/mcp/**/*",
    "backend/db/migrations",
    "backend/db/migrations/**/*",
    "**/node_modules/react-native/**",
    "components/**",
    "assets/**",
    "constants/**",
    "**/node_modules/@rork-ai/**"
  ]
}
