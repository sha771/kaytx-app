{
  "name": "@kaytx/audit-system",
  "version": "1.0.0",
  "description": "Platform Audit and Cleanup system for kaytx/kaytx",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:property": "jest --testMatch='**/*.property.test.ts'",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "audit",
    "cleanup",
    "code-quality",
    "static-analysis",
    "refactoring"
  ],
  "author": "kaytx Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "typescript": "~5.9.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "fast-check": "^4.5.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
