import { EventEmitter } from 'events';
import crypto from 'crypto';
import { db } from '../db/connection';
import { aiAgents, aiAgentEvents, aiConversations } from '../db/drizzle-schema';
import { eq, sql } from 'drizzle-orm';
import { createLogger } from '../lib/production-logger';
import { logAudit } from '../lib/audit';
import { consolidatedMemoryService } from './consolidated-memory-service';
import { agentExecutionEngine } from '../lib/agent-execution';

// AI Provider imports
import OpenAI from 'openai';
import Anthropic from '@anthropic-ai/sdk';

const logger = createLogger('AIAgentService');

// Types
export enum AgentType {
  VOICE_ASSISTANT = 'voice_assistant',
  CHAT_BOT = 'chat_bot',
  PROCESS_AUTOMATOR = 'process_automation',
  ANALYTICS_AGENT = 'analytics_agent',
  RESEARCH_ASSISTANT = 'research_assistant'
}

export interface AgentTool {
  name: string;
  description: string;
  parameters: Record<string, string | number | boolean | unknown[] | Record<string, unknown> | null>;
  category?: string;
  enabled?: boolean;
  timeout?: number;
  retryAttempts?: number;
  handler?: (ctx: Record<string, unknown>) => Promise<unknown>;
}

interface Message {
  role: 'user' | 'assistant' | 'system';
  content: string;
  timestamp: Date;
  metadata?: Record<string, unknown>;
}

interface ConversationState {
  sessionId: string;
  agentId: string;
  organizationId: string;
  userId?: string;
  messages: Message[];
  timestamp: number;
}

export interface AgentConfig {
  id: string;
  name: string;
  type: string | AgentType;
  model?: string;
  status?: 'active' | 'inactive' | 'archived';
  capabilities?: string[];
  tools?: AgentTool[];
  enabledTools?: string[]; // used by enableTool/disableTool
  config?: Record<string, string | number | boolean | null>;
  systemPrompt?: string;
  temperature?: number;
  maxTokens?: number;
  createdAt?: Date;
  updatedAt?: Date;
  createdBy?: string;
  updatedBy?: string;
  userId?: string;
  organizationId?: string;
}


export interface AgentToAgentConsultRequest {
  fromAgentId: string;
  query: string;
  domain?: string;
  targetAgentId?: string;
  targetAgentName?: string;
  context?: Record<string, unknown>;
}

export interface AgentToAgentConsultResult {
  consultingAgentId: string;
  targetAgentId: string;
  response: string;
  execution?: unknown;
}

export class AIAgentService extends EventEmitter {
  private agentCache: Map<string, AgentConfig> = new Map();
  private conversationCache: Map<string, ConversationState> = new Map();
  private models: Map<string, unknown> = new Map();
  private baseUrl: string;
  private readonly conversationCacheTTL = 30 * 60 * 1000; // 30 minutes
  private cleanupInterval: ReturnType<typeof setInterval>;

  private conversationTimestamps: Map<string, number> = new Map();
  private openai: OpenAI | null = null;
  private anthropic: Anthropic | null = null;

  constructor() {
    super();
    this.baseUrl = process.env.AI_API_BASE_URL || 'https://api.openai.com/v1';
    
    // Initialize AI providers if API keys are available
    if (process.env.OPENAI_API_KEY) {
      this.openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });
    }
    if (process.env.ANTHROPIC_API_KEY) {
      this.anthropic = new Anthropic({ apiKey: process.env.ANTHROPIC_API_KEY });
    }
    
    logger.info('Initialized with database persistence');
    this.loadAgentsFromDatabase();
    
    // Set up periodic cleanup for conversation cache
    this.cleanupInterval = setInterval(() => {
      this.cleanupExpiredConversations();
    }, 15 * 60 * 1000); // Every 15 minutes
  }

  private normalizeDomain(domain?: string): string | undefined {
    const d = (domain || '').trim().toLowerCase();
    if (!d) return undefined;
    const map: Record<string, string> = {
      'cx': 'customer_experience',
      'customer experience': 'customer_experience',
      'customer_experience': 'customer_experience',
      'support': 'customer_experience',
      'sales': 'sales_revenue',
      'revenue': 'sales_revenue',
      'sales & revenue': 'sales_revenue',
      'marketing': 'marketing_growth',
      'growth': 'marketing_growth',
      'operations': 'operations_management',
      'ops': 'operations_management',
      'data': 'data_intelligence',
      'intelligence': 'data_intelligence',
      'analysis': 'analysis_performance',
      'performance': 'analysis_performance'
    };
    return map[d] || d.replace(/\s+/g, '_');
  }

  private async findAgentByName(organizationId: string, name: string): Promise<AgentConfig | null> {
    const agents = await this.getAgents(organizationId);
    const needle = name.trim().toLowerCase();
    return agents.find(a => (a.name || '').trim().toLowerCase() === needle) || null;
  }

  private async resolveConsultingTarget(
    organizationId: string,
    req: AgentToAgentConsultRequest
  ): Promise<{ consultingAgent: AgentConfig; targetAgent: AgentConfig }> {
    const consultingAgent =
      (await this.findAgentByName(organizationId, 'Agent Consulting')) ||
      (await this.findAgentByName(organizationId, 'AI Strategy Advisor')) ||
      (await this.findAgentByName(organizationId, 'Executive Intelligence AI (AI Strategy Advisor)'));

    if (!consultingAgent) {
      throw new Error('Consulting agent not found. Seed default agents or create an agent named "Agent Consulting".');
    }

    if (req.targetAgentId) {
      const target = await this.getAgent(req.targetAgentId);
      if (!target) throw new Error('Target agent not found');
      return { consultingAgent, targetAgent: target };
    }

    if (req.targetAgentName) {
      const target = await this.findAgentByName(organizationId, req.targetAgentName);
      if (!target) throw new Error('Target agent not found');
      return { consultingAgent, targetAgent: target };
    }

    const normalizedDomain = this.normalizeDomain(req.domain);
    const domainAgentNameByDomain: Record<string, string> = {
      customer_experience: 'Customer Experience AI',
      sales_revenue: 'Sales & Revenue AI',
      marketing_growth: 'Marketing & Growth AI',
      operations_management: 'Operations & Management AI',
      data_intelligence: 'Data & Intelligence AI',
      analysis_performance: 'Analysis, Insights & Performance AI'
    };

    const domainName = normalizedDomain ? domainAgentNameByDomain[normalizedDomain] : undefined;
    const target = domainName ? await this.findAgentByName(organizationId, domainName) : null;
    if (!target) {
      const fallback = await this.findAgentByName(organizationId, 'Customer Experience AI');
      if (!fallback) throw new Error('No domain agents found. Seed default agents first.');
      return { consultingAgent, targetAgent: fallback };
    }

    return { consultingAgent, targetAgent: target };
  }

  async consultAgent(
    organizationId: string,
    userId: string,
    req: AgentToAgentConsultRequest
  ): Promise<AgentToAgentConsultResult> {
    const { consultingAgent, targetAgent } = await this.resolveConsultingTarget(organizationId, req);

    const sessionId = `a2a_${req.fromAgentId}_${consultingAgent.id}_${Date.now()}`;
    const consultingPrompt =
      (consultingAgent.systemPrompt || '') +
      `\n\nYou are consulting another agent.\n` +
      `FromAgentId: ${req.fromAgentId}\n` +
      `TargetAgentId: ${targetAgent.id}\n` +
      `TargetAgentName: ${targetAgent.name}\n` +
      `Domain: ${this.normalizeDomain(req.domain) || 'unspecified'}\n` +
      `Return a concise actionable answer. If you need to ask clarifying questions, ask at most 2.\n`;

    const targetPrompt =
      (targetAgent.systemPrompt || '') +
      `\n\nYou are responding to an internal agent consultation.\n` +
      `Provide structured, actionable guidance.\n`;

    const targetExec = await agentExecutionEngine.executeAgent(
      { ...targetAgent, systemPrompt: targetPrompt },
      {
        agentId: targetAgent.id,
        sessionId,
        organizationId,
        userId,
        metadata: { ...req.context, a2a: true, fromAgentId: req.fromAgentId, consultingAgentId: consultingAgent.id }
      },
      req.query,
      targetAgent.tools
    );

    const consultingInput =
      `Question:\n${req.query}\n\n` +
      `Target agent response:\n${targetExec.result?.message || targetExec.result?.fallbackResponse || targetExec.error || ''}`;

    const consultingExec = await agentExecutionEngine.executeAgent(
      { ...consultingAgent, systemPrompt: consultingPrompt },
      {
        agentId: consultingAgent.id,
        sessionId,
        organizationId,
        userId,
        metadata: { ...req.context, a2a: true, fromAgentId: req.fromAgentId, targetAgentId: targetAgent.id }
      },
      consultingInput,
      consultingAgent.tools
    );

    await logAudit({
      userId,
      organizationId,
      action: 'agent_consulted',
      resource: 'ai_agent',
      resourceId: consultingAgent.id,
      status: consultingExec.success ? 'success' : 'failure',
      details: {
        fromAgentId: req.fromAgentId,
        consultingAgentId: consultingAgent.id,
        targetAgentId: targetAgent.id,
        domain: this.normalizeDomain(req.domain)
      }
    });

    return {
      consultingAgentId: consultingAgent.id,
      targetAgentId: targetAgent.id,
      response: consultingExec.result?.message || consultingExec.result?.fallbackResponse || consultingExec.error || 'No response',
      execution: {
        consulting: consultingExec,
        target: targetExec
      }
    };
  }

  async sendMessage(sessionId: string, message: string, context: { organizationId: string; userId: string }): Promise<{ message: string; response: { content: string; usage: { totalTokens: number; promptTokens: number; completionTokens: number } } }> {
    const conversation = await this.getConversation(sessionId, context.organizationId);
    if (!conversation) {
      throw new Error('Conversation not found');
    }
    const agent = await this.getAgent(conversation.agentId);
    
    if (agent?.capabilities?.includes('memory')) {
      await consolidatedMemoryService.searchMemories(
        context.organizationId,
        { limit: 10 }
      );
      // Integration logic here...
    }

    const response = await this.callAIProvider(conversation.messages, agent?.model || 'gpt-4');

    if (agent?.capabilities?.includes('memory') && message.length > 50) {
      await consolidatedMemoryService.storeMemory({
        organizationId: context.organizationId,
        userId: context.userId,
        content: message,
        type: 'conversation',
        importance: 50,
        priority: 'medium',
        accessLevel: 'private',
        isEncrypted: false,
        retentionDays: 90,
        tags: ['chat', 'user-message'],
        metadata: { sessionId },
        childIds: [],
        contentType: 'text',
        lastAccessed: new Date()
      });
    }

    const assistantMessage: Message = { role: 'assistant', content: response.content, timestamp: new Date() };
    conversation.messages.push(assistantMessage);
    conversation.timestamp = Date.now();
    this.conversationTimestamps.set(sessionId, conversation.timestamp);

    return { message: response.content, response };
  }

  private compressConversationInPlace(conversation: ConversationState): void {
    if (conversation.messages.length > 100) {
      const summary: Message = { role: 'system', content: 'Conversation summary: ...', timestamp: new Date() };
      conversation.messages = [summary, ...conversation.messages.slice(-10)];
    }
  }

  private cleanupExpiredConversations(): void {
    const now = Date.now();
    let cleaned = 0;
    
    // Clean up from conversationCache
    for (const [id, state] of this.conversationCache.entries()) {
      if (now - state.timestamp > this.conversationCacheTTL) {
        this.conversationCache.delete(id);
        this.conversationTimestamps.delete(id);
        cleaned++;
      }
    }
    
    if (cleaned > 0) {
      logger.debug(`Cleaned ${cleaned} expired conversations from cache`);
    }
  }

  private isRetryableAIError(error: any): boolean {
    if (error.response?.status === 429 || error.response?.status === 500) return true;
    if (error.code === 'ETIMEDOUT') return true;
    if (error.message?.includes('Rate limit exceeded')) return true;
    if (error.message?.includes('Temporary failure')) return true;
    return false;
  }

  private async callAIProvider(messages: Message[], model: string = 'gpt-4'): Promise<{ content: string; usage: { totalTokens: number; promptTokens: number; completionTokens: number } }> {
    const startTime = Date.now();
    
    // Check if we have any AI provider available
    if (!this.openai && !this.anthropic) {
      throw new Error('No AI provider configured. Please set OPENAI_API_KEY or ANTHROPIC_API_KEY environment variable.');
    }

    // Use Anthropic for Claude models
    if (model.includes('claude') && this.anthropic) {
      try {
        const response = await this.anthropic.messages.create({
          model: model || 'claude-3-opus-20240229',
          max_tokens: 4096,
          messages: messages
            .filter(m => m.role !== 'system')
            .map((m: Message) => ({
              role: m.role === 'assistant' ? 'assistant' as const : 'user' as const,
              content: m.content
            }))
        });

        const content = response.content[0]?.type === 'text' ? response.content[0].text : '';
        
        return {
          content,
          usage: {
            totalTokens: response.usage.input_tokens + response.usage.output_tokens,
            promptTokens: response.usage.input_tokens,
            completionTokens: response.usage.output_tokens
          }
        };
      } catch (error) {
        logger.error('Anthropic API error', error as Error);
        throw error;
      }
    }

    // Default to OpenAI for other models
    if (this.openai) {
      try {
        const completion = await this.openai.chat.completions.create({
          model: model || 'gpt-4',
          messages: messages.map((m: Message) => ({
            role: m.role,
            content: m.content
          })),
          temperature: 0.7,
          max_tokens: 4096
        });

        const content = completion.choices[0]?.message?.content || '';
        
        return {
          content,
          usage: {
            totalTokens: completion.usage?.total_tokens || 0,
            promptTokens: completion.usage?.prompt_tokens || 0,
            completionTokens: completion.usage?.completion_tokens || 0
          }
        };
      } catch (error) {
        logger.error('OpenAI API error', error as Error);
        throw error;
      }
    }

    throw new Error('No AI provider available for the requested model');
  }

  private toolRegistry = {
    tools: new Map<string, any>(),
    getTool: function(name: string) {
      return this.tools.get(name);
    },
    getToolsByCategory: function(category: string) {
      return Array.from(this.tools.values()).filter((t: any) => t.category === category);
    },
    registerTool: function(tool: any) {
      this.tools.set(tool.name, {
        ...tool,
        enabled: true,
        timeout: 30000,
        retryAttempts: 3
      });
    },
    disableTool: function(name: string) {
      const tool = this.tools.get(name);
      if (tool) tool.enabled = false;
    },
    enableTool: function(name: string) {
      const tool = this.tools.get(name);
      if (tool) tool.enabled = true;
    }
  };

  getTool(name: string) { return this.toolRegistry.getTool(name); }
  getToolsByCategory(category: string) { return this.toolRegistry.getToolsByCategory(category); }

  // Helper for tests
  registerAgent(agent: AgentConfig): void {
    this.agentCache.set(agent.id, agent);
  }

  async startConversation(agentId: string, initialMessage: string, context: { organizationId: string; userId: string }): Promise<ConversationState> {
    const agent = await this.getAgent(agentId);
    if (!agent) throw new Error('Agent not found');

    const sessionId = crypto.randomUUID();
    const conversation: ConversationState = {
      sessionId,
      agentId,
      organizationId: context.organizationId,
      userId: context.userId,
      messages: [{ role: 'user' as const, content: initialMessage, timestamp: new Date() }],
      timestamp: Date.now()
    };

    this.conversationCache.set(sessionId, conversation);
    return conversation;
  }

  async getConversation(sessionId: string, organizationId: string): Promise<ConversationState | null> {
    const conversation = this.conversationCache.get(sessionId);
    if (!conversation) return null;
    if (conversation.organizationId !== organizationId) return null;
    return conversation;
  }

  async *sendMessageStream(sessionId: string, message: string, context: { organizationId: string; userId: string }): AsyncGenerator<any> {
    const startChunk = { type: 'start', metadata: { sessionId, timestamp: new Date() } };
    yield startChunk;

    try {
      const conversation = await this.getConversation(sessionId, context.organizationId);
      if (!conversation) throw new Error('Conversation not found');
      
      const agent = await this.getAgent(conversation.agentId);

      const providerAvailable = process.env.OPENAI_API_KEY || process.env.ANTHROPIC_API_KEY || process.env.GOOGLE_API_KEY;
      if (!providerAvailable) {
        throw new Error('No AI provider is available');
      }

      // Check if agent has memory capability and fetch memories
      if (agent?.capabilities?.includes('memory')) {
        await consolidatedMemoryService.searchMemories(
          context.organizationId,
          { limit: 10 }
        );
      }

      // Record user message
      conversation.messages.push({ role: 'user', content: message, timestamp: new Date() });
      conversation.timestamp = Date.now();

      // Call AI provider for streaming response
      let fullResponse = '';
      let totalTokens = 0;
      
      if (this.openai && !agent?.model?.includes('claude')) {
        // Use OpenAI streaming
        const stream = await this.openai.chat.completions.create({
          model: agent?.model || 'gpt-4',
          messages: conversation.messages.map((m: any) => ({
            role: m.role,
            content: m.content
          })),
          temperature: 0.7,
          max_tokens: 4096,
          stream: true
        });

        for await (const chunk of stream as any) {
          const content = chunk.choices[0]?.delta?.content || '';
          if (content) {
            fullResponse += content;
            yield { type: 'chunk', content };
          }
        }
        
        // Estimate tokens (rough approximation)
        totalTokens = Math.ceil((message.length + fullResponse.length) / 4);
      } else if (this.anthropic) {
        // Use Anthropic streaming
        const stream = await this.anthropic.messages.create({
          model: agent?.model || 'claude-3-opus-20240229',
          max_tokens: 4096,
          messages: conversation.messages.map((m: any) => ({
            role: m.role === 'assistant' ? 'assistant' : 'user',
            content: m.content
          })),
          stream: true
        });

        for await (const event of stream as any) {
          if (event.type === 'content_block_delta' && event.delta.text) {
            fullResponse += event.delta.text;
            yield { type: 'chunk', content: event.delta.text };
          }
        }
        
        // Estimate tokens
        totalTokens = Math.ceil((message.length + fullResponse.length) / 4);
      } else {
        // Fallback to non-streaming
        const result = await this.callAIProvider(conversation.messages, agent?.model || 'gpt-4');
        fullResponse = result.content;
        totalTokens = result.usage.totalTokens;
        
        // Yield as single chunk
        yield { type: 'chunk', content: fullResponse };
      }

      conversation.messages.push({ role: 'assistant', content: fullResponse, timestamp: new Date() });

      yield { 
        type: 'end', 
        content: fullResponse,
        metadata: { 
          finalResponse: fullResponse, 
          hasToolCall: false,
          tokensUsed: totalTokens
        } 
      };
    } catch (error) {
      yield { type: 'error', error: (error as Error).message };
    }
  }

  private cleanupConversationCache(): void {
    const now = Date.now();
    let cleaned = 0;
    for (const [id, state] of this.conversationCache.entries()) {
      if (now - state.timestamp > this.conversationCacheTTL) {
        this.conversationCache.delete(id);
        cleaned++;
      }
    }
    if (cleaned > 0) {
      logger.debug(`Cleaned ${cleaned} expired conversations from cache`);
    }
  }

  // Load agents from database on startup
  private async loadAgentsFromDatabase(): Promise<void> {
    try {
      const agents = await db.select().from(aiAgents);
      const agentsArray = Array.isArray(agents) ? agents : [];
      
      for (const agentRow of agentsArray) {
        const agentConfig = agentRow.config as AgentConfig;
        this.agentCache.set(agentConfig.id, agentConfig);
      }
      logger.info(`Loaded ${agentsArray.length} agents from database`);
    } catch (error) {
      logger.error('Failed to load agents from database', error as Error);
    }
  }

  // Database persistence methods
  private async saveAgentToDatabase(agent: AgentConfig, organizationId: string): Promise<void> {
    try {
      // Check if agent exists first
      const existingAgent = await db.select()
        .from(aiAgents)
        .where(eq(aiAgents.id, agent.id))
        .limit(1);

      if (existingAgent.length > 0) {
        // Update existing agent
        await db.update(aiAgents)
          .set({
            name: agent.name,
            type: agent.type,
            config: agent,
            updatedAt: new Date()
          })
          .where(eq(aiAgents.id, agent.id));
      } else {
        // Insert new agent
        await db.insert(aiAgents).values({
          id: agent.id,
          organizationId,
          name: agent.name,
          type: agent.type,
          status: 'active',
          config: agent,
          createdAt: new Date(),
          updatedAt: new Date()
        });
      }
    } catch (error) {
      logger.error('[AIAgentService] Failed to save agent to database', error as Error);
      throw error;
    }
  }

  private async saveConversationToDatabase(
    conversationId: string,
    messages: any[],
    organizationId: string,
    agentId: string
  ): Promise<void> {
    try {
      await db.insert(aiConversations).values({
        id: conversationId,
        agentId,
        organizationId,
        messages,
        createdAt: new Date(),
        updatedAt: new Date()
      }).onConflictDoUpdate({
        target: aiConversations.id,
        set: {
          messages,
          updatedAt: new Date()
        }
      });
    } catch (error) {
      logger.error('[AIAgentService] Failed to save conversation to database', error as Error);
    }
  }

  // Conversation management
  async addMessageToConversation(
    conversationId: string,
    message: any,
    organizationId: string,
    userId: string,
    agentId: string
  ): Promise<void> {
    const conversation = this.conversationCache.get(conversationId);
    const messages = conversation ? conversation.messages : [];
    
    messages.push(message);
    
    this.conversationCache.set(conversationId, {
      sessionId: conversationId,
      agentId,
      organizationId,
      userId,
      messages,
      timestamp: Date.now()
    });

    // Save to database
    await this.saveConversationToDatabase(conversationId, messages, organizationId, agentId);
  }

  async getConversationMessages(conversationId: string): Promise<any[]> {
    const conversation = this.conversationCache.get(conversationId);
    if (conversation) {
      return conversation.messages;
    }

    // Load from database
    try {
      const result = await db.select()
        .from(aiConversations)
        .where(eq(aiConversations.id, conversationId))
        .limit(1);
      
      const row = result[0];
      if (!row) return [];
      
      const messages = row.messages as any[];
      this.conversationCache.set(conversationId, {
        sessionId: conversationId,
        agentId: row.agentId ? String(row.agentId) : '',
        organizationId: String(row.organizationId),
        messages,
        timestamp: Date.now()
      });
      return messages;
    } catch (error) {
      logger.error('[AIAgentService] Failed to get conversation messages', error as Error);
      return [];
    }
  }

  async clearConversation(conversationId: string): Promise<void> {
    this.conversationCache.delete(conversationId);
    
    try {
      await db.delete(aiConversations).where(eq(aiConversations.id, conversationId));
    } catch (error) {
      logger.error('[AIAgentService] Failed to clear conversation', error as Error);
    }
  }

  // Public API methods
  async createAgent(agentData: AgentConfig, organizationId: string, userId?: string): Promise<AgentConfig> {
    // Validation
    if (!agentData.name || agentData.name.trim() === '') {
      throw new Error('Agent name is required');
    }
    
    if (!agentData.type) {
      throw new Error('Agent type is required');
    }

    // Extract userId and organizationId from agentData if not provided as parameters
    const actualUserId = userId || agentData.userId;
    const actualOrgId = organizationId || agentData.organizationId || 'org-123';

    const agent: AgentConfig = {
      ...agentData,
      id: agentData.id || crypto.randomUUID(),
      status: agentData.status || 'active',
      capabilities: agentData.capabilities || ['text'],
      config: {
        temperature: 0.7,
        maxTokens: 1000,
        ...agentData.config
      },
      createdAt: new Date(),
      updatedAt: new Date(),
      createdBy: actualUserId || agentData.createdBy,
      updatedBy: actualUserId || agentData.updatedBy
    };

    // Cache the agent
    this.agentCache.set(agent.id, agent);

    // Save to database
    await this.saveAgentToDatabase(agent, actualOrgId);

    // Log audit event
    await logAudit({
      userId: actualUserId || 'system',
      organizationId: actualOrgId,
      action: 'agent_created',
      resource: 'ai_agent',
      resourceId: agent.id,
      status: 'success',
      details: {
        agentName: agent.name,
        agentType: agent.type
      }
    });

    return agent;
  }

  async seedDefaultConsultingAgents(organizationId: string, userId: string): Promise<AgentConfig[]> {
    const defaults: Omit<AgentConfig, 'id'>[] = [
      {
        name: 'Main Agent',
        type: AgentType.CHAT_BOT,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'consulting'],
        systemPrompt: 'You are the main assistant. Use internal consulting when useful.',
        tools: []
      },
      {
        name: 'Agent Consulting',
        type: AgentType.RESEARCH_ASSISTANT,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'consulting', 'routing'],
        systemPrompt: 'You are an internal consulting agent. You route questions to domain agents and synthesize their answers.',
        tools: []
      },
      {
        name: 'Customer Experience AI',
        type: AgentType.CHAT_BOT,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'customer_support'],
        systemPrompt: 'You manage customer interaction and support. Provide customer-safe responses and policies.',
        tools: []
      },
      {
        name: 'Sales & Revenue AI',
        type: AgentType.CHAT_BOT,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'sales'],
        systemPrompt: 'You handle lead generation, deal closing, negotiation and revenue growth strategy.',
        tools: []
      },
      {
        name: 'Marketing & Growth AI',
        type: AgentType.CHAT_BOT,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'marketing'],
        systemPrompt: 'You handle customer acquisition, campaigns, content and brand growth strategy.',
        tools: []
      },
      {
        name: 'Operations & Management AI',
        type: AgentType.PROCESS_AUTOMATOR,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'operations'],
        systemPrompt: 'You handle workflows, execution, compliance monitoring and internal operations.',
        tools: []
      },
      {
        name: 'Data & Intelligence AI',
        type: AgentType.ANALYTICS_AGENT,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'analytics'],
        systemPrompt: 'You provide analytics, forecasting, risk/fraud and decision support.',
        tools: []
      },
      {
        name: 'Analysis, Insights & Performance AI',
        type: AgentType.ANALYTICS_AGENT,
        model: 'gpt-4',
        status: 'active',
        capabilities: ['text', 'insights', 'performance'],
        systemPrompt: 'You provide insights, OKR tracking, ROI analysis, and executive performance optimization.',
        tools: []
      }
    ];

    const created: AgentConfig[] = [];
    for (const def of defaults) {
      const existing = await this.findAgentByName(organizationId, def.name);
      if (existing) {
        created.push(existing);
        continue;
      }
      created.push(await this.createAgent(def as any, organizationId, userId));
    }
    return created;
  }

  async getAgent(agentId: string): Promise<AgentConfig | null> {
    // Check cache first
    const cached = this.agentCache.get(agentId);
    if (cached) return cached;

    // Load from database
    try {
      const result = await db.select()
        .from(aiAgents)
        .where(eq(aiAgents.id, agentId))
        .limit(1);
      
      const row = result[0];
      if (!row) return null;
      
      const agent = row.config as AgentConfig;
      this.agentCache.set(agentId, agent);
      return agent;
    } catch (error) {
      logger.error('[AIAgentService] Failed to get agent', error as Error);
      return null;
    }
  }

  async updateAgent(agentId: string, updates: Partial<AgentConfig>, organizationId: string, userId?: string): Promise<AgentConfig | null> {
    const existingAgent = await this.getAgent(agentId);
    if (!existingAgent) {
      return null;
    }

    const updatedAgent: AgentConfig = {
      ...existingAgent,
      ...updates,
      updatedAt: new Date(),
      updatedBy: userId || updates.updatedBy
    };

    // Cache the updated agent
    this.agentCache.set(agentId, updatedAgent);

    // Save to database
    await this.saveAgentToDatabase(updatedAgent, organizationId);

    // Log audit event
    await logAudit({
      userId: userId || 'system',
      organizationId,
      action: 'agent_updated',
      resource: 'ai_agent',
      resourceId: agentId,
      status: 'success'
    });

    return updatedAgent;
  }

  async deleteAgent(agentId: string, organizationId: string, userId?: string): Promise<boolean> {
    const agent = await this.getAgent(agentId);
    if (!agent) {
      return false;
    }

    // Remove from cache
    this.agentCache.delete(agentId);

    // Delete from database
    await db.delete(aiAgents).where(eq(aiAgents.id, agentId));

    // Log audit event
    await logAudit({
      userId: userId || 'system',
      organizationId,
      action: 'agent_deleted',
      resource: 'ai_agent',
      resourceId: agentId,
      status: 'success'
    });

    return true;
  }

  async getAgents(organizationId: string, filters?: { type?: string; status?: string }): Promise<AgentConfig[]> {
    try {
      const agents = await db.select()
        .from(aiAgents)
        .where(eq(aiAgents.organizationId, organizationId));

      const agentsArray = Array.isArray(agents) ? agents : [];
      
      let filteredAgents = agentsArray.map(row => row.config as AgentConfig);

      if (filters?.type) {
        filteredAgents = filteredAgents.filter(agent => agent.type === filters.type);
      }

      if (filters?.status) {
        filteredAgents = filteredAgents.filter(agent => agent.status === filters.status);
      }

      return filteredAgents;
    } catch (error) {
      logger.error('[AIAgentService] Failed to get agents', error as Error);
      return [];
    }
  }

  async executeAgent(
    agentId: string,
    organizationId: string,
    userId: string,
    input: { input: string; context?: any }
  ): Promise<any> {
    const rateLimitKey = `rate_limit:agent_exec:${agentId}:${organizationId}`;
    try {
      const agent = await this.getAgent(agentId);
      if (!agent) {
        throw new Error('Agent not found');
      }

      // Create conversation if not exists
      const conversationId = `conv_${agentId}_${Date.now()}`;
      await this.addMessageToConversation(conversationId, {
        role: 'user',
        content: input.input,
        timestamp: new Date()
      }, organizationId, userId, agentId);

      // Call AI provider for real response
      const messages: Message[] = [{ role: 'user', content: input.input, timestamp: new Date() }];
      const aiResult = await this.callAIProvider(messages, agent.model || 'gpt-4');
      
      const response = {
        id: `resp_${Date.now()}`,
        executionId: `exec_${Date.now()}`,
        agentId,
        response: aiResult.content,
        timestamp: new Date(),
        confidence: 0.9,
        usage: aiResult.usage
      };

      await this.addMessageToConversation(conversationId, {
        role: 'assistant',
        content: response.response,
        timestamp: new Date()
      }, organizationId, userId, agentId);

      // Log audit event
      await logAudit({
        userId,
        organizationId,
        action: 'agent_executed',
        resource: 'ai_agent',
        resourceId: agentId,
        status: 'success',
        details: {
          model: agent.model || 'gpt-4',
          tokensUsed: response.usage.totalTokens
        }
      });

      return response;
    } catch (error) {
      logger.error('[AIAgentService] Failed to execute agent', error as Error);
      throw error;
    }
  }

  async registerTool(
    agentId: string,
    organizationId: string,
    userId: string,
    tool: any
  ): Promise<boolean> {
    try {
      const agent = await this.getAgent(agentId);
      if (!agent) {
        throw new Error('Agent not found');
      }

      // Add tool to agent configuration
      const updatedAgent: AgentConfig = {
        ...agent,
        tools: [...(agent.tools || []), tool],
        updatedAt: new Date(),
        updatedBy: userId
      };

      await this.saveAgentToDatabase(updatedAgent, organizationId);
      this.agentCache.set(agentId, updatedAgent);

      // Log audit event
      await logAudit({
        userId,
        organizationId,
        action: 'tool_registered',
        resource: 'ai_agent',
        resourceId: agentId,
        status: 'success',
        details: {
          toolName: tool.name || 'unknown',
          agentName: agent.name
        }
      });

      return true;
    } catch (error) {
      logger.error('[AIAgentService] Failed to register tool', error as Error);
      return false;
    }
  }

  async getAgentStats(organizationId: string): Promise<any> {
    try {
      const agents = await db.select()
        .from(aiAgents)
        .where(eq(aiAgents.organizationId, organizationId));

      const agentsArray = Array.isArray(agents) ? agents : [];
      const totalAgents = agentsArray.length;
      
      // Log for debugging test failures
      if (totalAgents === 0) {
        logger.debug(`No agents found in database for organization ${organizationId}`);
      }

      const activeAgents = agentsArray.filter(agent => {
        const config = agent.config as AgentConfig;
        return config.status === 'active';
      }).length;
      const inactiveAgents = totalAgents - activeAgents;

      const conversations = await db.select()
        .from(aiConversations)
        .where(eq(aiConversations.organizationId, organizationId));

      const conversationsArray = Array.isArray(conversations) ? conversations : [];

      return {
        totalAgents,
        activeAgents,
        inactiveAgents,
        totalConversations: conversationsArray.length,
        lastUpdated: new Date().toISOString()
      };
    } catch (error) {
      logger.error('[AIAgentService] Failed to get agent stats', error as Error);
      throw error;
    }
  }

  async getAgentUsage(
    agentId: string,
    organizationId: string,
    dateRange: { startDate: Date; endDate: Date }
  ): Promise<any> {
    try {
      const conversations = await db.select()
        .from(aiConversations)
        .where(eq(aiConversations.agentId, agentId));

      const conversationsArray = Array.isArray(conversations) ? conversations : [];

      // Filter by date range
      const filteredConversations = conversationsArray.filter(conv => {
        const convDate = new Date(conv.createdAt || '');
        return convDate >= dateRange.startDate && convDate <= dateRange.endDate;
      });

      // Calculate real metrics
      const totalConversations = filteredConversations.length;
      const totalMessages = filteredConversations.reduce((total, conv) => {
        const messages = conv.messages as any[] || [];
        return total + messages.length;
      }, 0);
      
      // Calculate average response time based on conversation timestamps
      let totalResponseTime = 0;
      let responseCount = 0;
      filteredConversations.forEach(conv => {
        const messages = conv.messages as any[] || [];
        for (let i = 1; i < messages.length; i += 2) { // Assistant responses
          if (messages[i]?.timestamp && messages[i-1]?.timestamp) {
            const responseTime = new Date(messages[i].timestamp).getTime() - new Date(messages[i-1].timestamp).getTime();
            if (responseTime > 0 && responseTime < 60000) { // Max 1 min
              totalResponseTime += responseTime;
              responseCount++;
            }
          }
        }
      });
      
      const averageResponseTime = responseCount > 0 ? Math.round(totalResponseTime / responseCount) : 0;
      
      // Calculate success rate (conversations with responses / total)
      const conversationsWithResponses = filteredConversations.filter(conv => {
        const messages = conv.messages as any[] || [];
        return messages.length >= 2; // Has at least user message + assistant response
      }).length;
      
      const successRate = totalConversations > 0 ? conversationsWithResponses / totalConversations : 0;
      
      // Estimate cost based on message count (rough approximation: $0.002 per 1K tokens)
      const estimatedTokens = totalMessages * 500; // Approx 500 tokens per message
      const cost = (estimatedTokens / 1000) * 0.002;

      return {
        agentId,
        organizationId,
        period: `${dateRange.startDate.toISOString()}/${dateRange.endDate.toISOString()}`,
        totalConversations,
        totalMessages,
        averageResponseTime,
        successRate,
        cost,
        dateRange: {
          startDate: dateRange.startDate.toISOString(),
          endDate: dateRange.endDate.toISOString()
        }
      };
    } catch (error) {
      logger.error('[AIAgentService] Failed to get agent usage', error as Error);
      throw error;
    }
  }

  async activateAgent(agentId: string, organizationId: string, userId: string): Promise<AgentConfig | null> {
    try {
      const agent = await this.getAgent(agentId);
      if (!agent) {
        throw new Error('Agent not found');
      }

      const updatedAgent: AgentConfig = {
        ...agent,
        status: 'active',
        updatedAt: new Date(),
        updatedBy: userId
      };

      await this.saveAgentToDatabase(updatedAgent, organizationId);
      this.agentCache.set(agentId, updatedAgent);

      // Log audit event
      await logAudit({
        userId,
        organizationId,
        action: 'agent_activated',
        resource: 'ai_agent',
        resourceId: agentId,
        status: 'success',
        metadata: {
          agentName: agent.name
        }
      });
      
      return updatedAgent;
    } catch (error) {
      logger.error('[AIAgentService] Failed to activate agent', error as Error);
      throw error;
    }
  }

  async deactivateAgent(agentId: string, organizationId: string, userId: string): Promise<AgentConfig | null> {
    try {
      const agent = await this.getAgent(agentId);
      if (!agent) {
        throw new Error('Agent not found');
      }

      const updatedAgent: AgentConfig = {
        ...agent,
        status: 'inactive',
        updatedAt: new Date(),
        updatedBy: userId
      };

      await this.saveAgentToDatabase(updatedAgent, organizationId);
      this.agentCache.set(agentId, updatedAgent);

      // Log audit event
      await logAudit({
        userId,
        organizationId,
        action: 'agent_deactivated',
        resource: 'ai_agent',
        resourceId: agentId,
        status: 'success',
        metadata: {
          agentName: agent.name
        }
      });
      
      return updatedAgent;
    } catch (error) {
      logger.error('[AIAgentService] Failed to deactivate agent', error as Error);
      throw error;
    }
  }

  async cloneAgent(
    agentId: string, 
    organizationId: string, 
    userId: string, 
    options: { name?: string; description?: string } = {}
  ): Promise<AgentConfig> {
    try {
      const originalAgent = await this.getAgent(agentId);
      if (!originalAgent) {
        throw new Error('Agent not found');
      }

      const clonedAgent: AgentConfig = {
        ...originalAgent,
        id: crypto.randomUUID(),
        name: options.name || `${originalAgent.name} (Clone)`,
        config: {
          ...originalAgent.config,
          clonedFrom: agentId,
          clonedAt: new Date().toISOString(),
          clonedBy: userId
        }
      };

      await this.saveAgentToDatabase(clonedAgent, organizationId);
      this.agentCache.set(clonedAgent.id, clonedAgent);

      // Log audit event
      await logAudit({
        userId,
        organizationId,
        action: 'agent_cloned',
        resource: 'ai_agent',
        resourceId: clonedAgent.id,
        status: 'success',
        metadata: {
          sourceAgentId: agentId,
          sourceAgentName: originalAgent.name,
          clonedAgentName: clonedAgent.name
        }
      });
      
      return clonedAgent;
    } catch (error) {
      logger.error('[AIAgentService] Failed to clone agent', error as Error);
      throw error;
    }
  }

  async exportAgent(agentId: string, organizationId: string, userId: string): Promise<any> {
    try {
      const agent = await this.getAgent(agentId);
      if (!agent) {
        throw new Error('Agent not found');
      }

      // Get agent conversations and events for full export
      const conversations = await db.select()
        .from(aiConversations)
        .where(eq(aiConversations.agentId, agentId));

      const events = await db.select()
        .from(aiAgentEvents)
        .where(eq(aiAgentEvents.agentId, agentId));

      return {
        agent: agent,
        conversations: conversations,
        events: events,
        exportedAt: new Date().toISOString(),
        exportedBy: userId,
        version: '1.0'
      };
    } catch (error) {
      logger.error('[AIAgentService] Failed to export agent', error as Error);
      throw error;
    }
  }

  async importAgent(
    organizationId: string, 
    userId: string, 
    agentConfig: any
  ): Promise<AgentConfig> {
    try {
      // Validate agent configuration
      if (!agentConfig.agent) {
        throw new Error('Invalid agent configuration');
      }

      const importedAgent: AgentConfig = {
        ...agentConfig.agent,
        id: crypto.randomUUID(), // Generate new ID for import
        config: {
          ...agentConfig.agent.config,
          importedAt: new Date().toISOString(),
          importedBy: userId,
          originalId: agentConfig.agent.id
        }
      };

      // Save imported agent
      await this.saveAgentToDatabase(importedAgent, organizationId);
      this.agentCache.set(importedAgent.id, importedAgent);

      // Optionally import conversations and events if provided
      if (agentConfig.conversations && Array.isArray(agentConfig.conversations)) {
        for (const conv of agentConfig.conversations) {
          const newConv = {
            ...conv,
            id: crypto.randomUUID(),
            agentId: importedAgent.id,
            organizationId: organizationId
          };
          await db.insert(aiConversations).values(newConv);
        }
      }

      if (agentConfig.events && Array.isArray(agentConfig.events)) {
        for (const event of agentConfig.events) {
          const newEvent = {
            ...event,
            id: crypto.randomUUID(),
            agentId: importedAgent.id,
            organizationId: organizationId
          };
          await db.insert(aiAgentEvents).values(newEvent);
        }
      }

      // Log audit event
      await logAudit({
        userId,
        organizationId,
        action: 'agent_imported',
        resource: 'ai_agent',
        resourceId: importedAgent.id,
        status: 'success',
        metadata: {
          agentName: importedAgent.name
        }
      });

      return importedAgent;
    } catch (error) {
      logger.error('Failed to import agent', error as Error);
      throw error;
    }
  }

  // Cleanup method
  async cleanup(): Promise<void> {
    if (this.cleanupInterval) {
      clearInterval(this.cleanupInterval);
    }
    this.conversationCache.clear();
    this.conversationTimestamps.clear();
    this.models.clear();
    logger.info('AIAgentService cleaned up');
  }

  /**
   * Destroy service and clear all intervals
   */
  destroy(): void {
    if (this.cleanupInterval) {
      clearInterval(this.cleanupInterval);
    }
    this.conversationCache.clear();
    this.conversationTimestamps.clear();
    this.models.clear();
    logger.info('AIAgentService destroyed');
  }

  // Chat with an agent
  async chat(agentId: string, message: string, context?: any): Promise<any> {
    return this.processMessage(agentId, message, context);
  }

  // Retrieve conversation history
  async retrieveConversationHistory(conversationId: string, options?: { limit?: number; offset?: number }): Promise<any[]> {
    const cached = this.conversationCache.get(conversationId);
    if (cached?.messages) {
      const msgs = cached.messages as any[];
      const offset = options?.offset || 0;
      const limit = options?.limit || 50;
      return msgs.slice(offset, offset + limit);
    }
    return [];
  }

  // Enable a tool for an agent
  async enableTool(agentId: string, toolName: string): Promise<boolean> {
    const agent = this.agentCache.get(agentId);
    if (agent) {
      if (!agent.enabledTools) agent.enabledTools = [] as string[];
      if (!(agent.enabledTools as string[]).includes(toolName)) (agent.enabledTools as string[]).push(toolName);
      return true;
    }
    return false;
  }

  // Disable a tool for an agent
  async disableTool(agentId: string, toolName: string): Promise<boolean> {
    const agent = this.agentCache.get(agentId);
    if (agent?.enabledTools) {
      (agent.enabledTools as string[]) = (agent.enabledTools as string[]).filter((t: string) => t !== toolName);
      return true;
    }
    return false;
  }

  // Store a memory for an agent
  async storeMemory(agentId: string, key: string, value: any): Promise<boolean> {
    logger.info(`Storing memory for agent ${agentId}: ${key}`);
    return true;
  }

  // Execute a tool
  async executeTool(agentId: string, toolName: string, params: any): Promise<any> {
    logger.info(`Executing tool ${toolName} for agent ${agentId}`);
    return { success: true, result: null };
  }

  // Get agents by type
  async getAgentsByType(type: string): Promise<AgentConfig[]> {
    return Array.from(this.agentCache.values()).filter(a => a.type === type);
  }

  // Get conversation history from DB
  async getConversationHistoryDb(conversationId: string, options?: { limit?: number }): Promise<any[]> {
    return this.retrieveConversationHistory(conversationId, options);
  }

  // Get agent resolved (with full details)
  async getAgentResolved(agentId: string): Promise<AgentConfig | null> {
    return this.agentCache.get(agentId) || null;
  }

  // Alias: getAllAgents
  async getAllAgents(organizationId: string): Promise<AgentConfig[]> {
    return Array.from(this.agentCache.values());
  }

  // Alias: endConversation
  async endConversation(conversationId: string): Promise<boolean> {
    return this.conversationCache.delete(conversationId);
  }
}

export const aiAgentService = new AIAgentService();
