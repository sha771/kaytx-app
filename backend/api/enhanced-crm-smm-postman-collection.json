    {
      "name": "CRM - Smart Sequences",
      "item": [
        {
          "name": "Create Smart Sequence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hot Lead Nurture\",\n  \"trigger\": \"lead_score_change\",\n  \"conditions\": [\n    {\n      \"type\": \"score_threshold\",\n      \"operator\": \"greater_than\",\n      \"field\": \"leadScore\",\n      \"value\": 70\n    }\n  ],\n  \"actions\": [\n    {\n      \"type\": \"email\",\n      \"content\": \"Send personalized welcome\",\n      \"delay\": 0,\n      \"channel\": \"email\"\n    },\n    {\n      \"type\": \"task\",\n      \"content\": \"Schedule sales call\",\n      \"delay\": 24\n    },\n    {\n      \"type\": \"ai_consultation\",\n      \"content\": \"Review lead strategy\",\n      \"delay\": 48,\n      \"aiAgentId\": \"ai-sales-rep\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/enhanced/crm/smart-sequences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "enhanced", "crm", "smart-sequences"]
            },
            "description": "Create AI-optimized nurture sequence with automated actions"
          },
          "response": []
        }
      ]
    },
